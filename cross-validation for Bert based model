import os
from flair.data import Corpus
from flair.datasets import ColumnCorpus
from flair.embeddings import TransformerWordEmbeddings
from flair.models import SequenceTagger
from flair.trainers import ModelTrainer

def train_cross_validation(data_folder: str, num_folds: int = 10):
    """
    Trains models using cross-validation with existing fold datasets.
    """
    # Define columns
    columns = {0: "text", 1: "pos", 2: "ner"}
    
    # Label type
    label_type = "ner"
    
    # Results to track performance across folds
    results = []
    
    for fold in range(1, num_folds + 1):
        print(f"Training fold {fold}/{num_folds}")
        
        # Initialize corpus for this fold
        train_file = f"train_fold{fold}_column_dataset.txt"
        val_file = f"val_fold{fold}_column_dataset.txt"
        test_file = "test_column_dataset.txt"
        
        print(f"Loading corpus from: {data_folder}")
        print(f"Train file: {train_file}")
        print(f"Val file: {val_file}")
        print(f"Test file: {test_file}")
        
        fold_corpus: Corpus = ColumnCorpus(
            data_folder,
            columns,
            train_file=train_file,
            test_file=test_file,
            dev_file=val_file,
        )
        
        # Make label dictionary
        label_dict = fold_corpus.make_label_dictionary(label_type=label_type, add_unk=False)
        print(f"Fold {fold} Label Dictionary: {label_dict}")
        
        # Initialize BERT embeddings (using bert-base-uncased)
        embeddings = TransformerWordEmbeddings(
            model="/root/content/Bert-base-uncased",
            layers="-1",
            subtoken_pooling="first",
            fine_tune=True,
            use_context=True,
        )
        
        # Initialize sequence tagger
        tagger = SequenceTagger(
            hidden_size=256,
            embeddings=embeddings,
            tag_dictionary=label_dict,
            tag_type=label_type,
            use_crf=False,
            use_rnn=False,
            reproject_embeddings=False,
        )
        
        # Initialize trainer
        trainer = ModelTrainer(tagger, fold_corpus)
        
        # Run fine-tuning for this fold
        output_path = os.path.join("resources", "taggers", f"ner-bert-fold-{fold}")
        result = trainer.fine_tune(
            output_path,
            learning_rate=5.0e-6,
            mini_batch_size=4,
            mini_batch_chunk_size=1,
            max_epochs=20,
        )
        
        results.append((fold, result))
        
        print(f"Fold {fold} completed with result: {result}")
    
    # Print summary of results for all folds
    print("\nResults for each fold:")
    for fold, result in results:
        print(f"Fold {fold}: {result}")
    
    # Calculate and print average performance across folds
    if results:
        avg_f1 = sum(r[1]['test_score'] for r in results) / len(results)
        print(f"Average F1 score across all folds: {avg_f1:.4f}")

def main():
    # Path to your prepared datasets
    data_folder = "/root/datasets"
    
    # Run cross-validation training using existing datasets
    train_cross_validation(data_folder, num_folds=10)

if __name__ == "__main__":
    main()
